{
  "name": "All-in-one-Backend",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "generate-prisma": "bun prisma init --datasource-provider sqlite --output ../generated/prisma",
    "migrate": "bun prisma migrate dev --name init && bun prisma generate",
    "build": "bun install && bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "start": "./server"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/adapter-libsql": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "elysia": "latest",
    "prismabox": "^1.1.26"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^7.2.0"
  },
  "module": "src/index.js"
}
